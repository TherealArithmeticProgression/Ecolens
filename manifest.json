{
  "manifest_version": 3,
  "name": "EcoLens",
  "version": "0.1.0",
  "description": "Find openly licensed visual matches before generating a new image.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://api.openverse.org/*"],
  "action": { "default_title": "EcoLens", "default_popup": "popup.html" }
}
